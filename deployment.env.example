# Recovery-account deployment values. Copy to deployment.env (git-ignored),
# replace every value, then:
#   source deployment.env && scripts/render.sh
export RECOVERY_REGION='ap-east-1'
export DELEGATED_ADMIN_ACCOUNT_ID='222222222222'
export RECOVERY_ACCOUNT_ID='777777777777'

# AWS CLI profiles used by DEPLOYMENT_GUIDE.md (one per account).
export DA_PROFILE='bunker-delegated-admin'
export RECOVERY_PROFILE='bunker-recovery'

# Foundation inputs (used when running Recovery-ManageFoundation).
export VPC_CIDR='10.240.0.0/20'
export AZ_ID_1='ape1-az1'
export AZ_ID_2='ape1-az2'
# Bunker CMK that encrypts the Prod LAG vault. NONE is fine for testing the
# infrastructure; restores (step 3) need the real key ARN.
export SOURCE_KMS_KEY_ARN='NONE'
export TOOLS_BUCKET_NAME='NONE'

export OUT_DIR="${TMPDIR:-/tmp}/recovery-account-render"
